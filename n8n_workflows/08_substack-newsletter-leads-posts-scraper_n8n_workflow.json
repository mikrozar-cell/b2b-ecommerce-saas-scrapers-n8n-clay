    {
      "parameters": {
        "jsCode": "// Score Substack newsletters for B2B sponsorships by reaction/comment engagement and paid tier\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  let score = 35;\n  const signals = [];\n  const engagement = Number(j.reactions_count || 0) + Number(j.comments_count || 0) * 2;\n  if (engagement >= 50) {\n    score += 35;\n    signals.push(`High Reader Engagement (${engagement})`);\n  } else if (engagement >= 10) {\n    score += 20;\n    signals.push(`Active Audience (${engagement})`);\n  }\n  if (j.author_twitter || j.author_url) {\n    score += 15;\n    signals.push('Author Handle Found');\n  }\n  if (j.is_paid || j.has_paid_tier) {\n    score += 15;\n    signals.push('Monetized Paid Audience');\n  }\n  out.push({\n    json: {\n      ...j,\n      engagement_score: engagement,\n      lead_score: Math.min(100, score),\n      priority_tier: score >= 70 ? 'Tier 1 — Top Sponsor Fit' : 'Tier 2 — Archive Post',\n      scoring_signals: signals.join(' | ') || 'Substack Entry',\n      scored_at: new Date().toISOString()\n    }\n  });\n}\nreturn out;"
      },
